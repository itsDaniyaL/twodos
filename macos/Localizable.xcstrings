      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Karte zeigt die Farbe ihrer Liste. „Ein“ färbt die ganze Karte – kräftiger, aber unruhiger bei vielen Listen."
