        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke kaart toont de kleur van de lijst. Aan kleurt de hele kaart — opvallender, maar drukker bij veel lijsten."
          }
        },
        "ru" : {
          "stringUnit" : {
