    "“%@” doesn't contain the kind of data its name suggests. Only open it if you trust who added it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ enthält nicht die Art von Daten, die der Name vermuten lässt. Öffne die Datei nur, wenn du der Person vertraust, die sie hinzugefügt hat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ bevat niet het soort gegevens dat de naam doet vermoeden. Open het alleen als je vertrouwt wie het heeft toegevoegd."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» содержит не те данные, что следуют из названия. Открывай, только если доверяешь тому, кто его добавил."
          }
        }
      }
    },
    "“%@” is %@. Files can be up to %@." : {
